{
  "形式バージョン": 1,
  "マクロ名": "WordPress本文整形サンプル",
  "説明": "通常の正規表現置換とUnicode正規化を上から順番に実行する基準フォーマットです。",
  "手順": [
    {
      "手順名": "insert_@@@",
      "有効": true,
      "正規表現": true,
      "Unicode正規化": false,
      "Unicode正規化形式": null,
      "丸数字変換後ピリオド追加": false,
      "検索文字列": "(?m)^@@@$",
      "除外文字列": null,
      "置換文字列": "<!-- wp:spacer {\"height\":\"30px\"} -->\n<div style=\"height:30px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->"
    },
    {
      "手順名": "normalize_fullwidth_alphanumeric",
      "有効": true,
      "正規表現": true,
      "Unicode正規化": true,
      "Unicode正規化形式": "NFKC",
      "丸数字変換後ピリオド追加": false,
      "検索文字列": "[Ａ-Ｚａ-ｚ０-９]+",
      "除外文字列": null,
      "置換文字列": null
    }
  ]
}
