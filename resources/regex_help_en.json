    "match": "color, colour",
    "result": "",
    "mode": "search"
  },
  {
    "section": "Search: advanced",
    "topic": "Exact repeat",
    "explanation": "{3} repeats the preceding digit exactly three times; it can match inside a longer number.",
    "search": "\\d{3}",
    "replacement": "",
    "input": "12 1234",
    "match": "123",
    "result": "",
    "mode": "search"
  },
  {
    "section": "Search: advanced",
    "topic": "Either alternative",
    "explanation": "| means OR.",
    "search": "cat|dog",
    "replacement": "",
    "input": "cat and dog",
    "match": "cat, dog",
    "result": "",
    "mode": "search"
  },
  {
    "section": "Search: advanced",
    "topic": "Capture a group",
    "explanation": "Parentheses store 12 as group 1. Reuse it in replacement text with \\1 or \\g<1>.",
    "search": "(\\d+)\\.",
    "replacement": "",
    "input": "12. Task",
    "match": "12.",
    "result": "",
    "mode": "search"
  },
  {
    "section": "Search: advanced",
    "topic": "Noncapturing group",
    "explanation": "(?:...) groups alternatives without giving them a group number.",
    "search": "(?:cat|dog)s",
    "replacement": "",
    "input": "cats dogs",
    "match": "cats, dogs",
    "result": "",
    "mode": "search"
  },
  {
    "section": "Search: advanced",
    "topic": "Word boundary",
    "explanation": "\\b matches a word edge, not a character.",
    "search": "\\bcat\\b",
    "replacement": "",
    "input": "cat scatter",
    "match": "cat",
    "result": "",
    "mode": "search"
  },
  {
    "section": "Search: advanced",
    "topic": "Lookahead",
    "explanation": "The following s is checked but not included in the match.",
    "search": "cat(?=s)",
    "replacement": "",
    "input": "cats cat",
    "match": "cat (in cats)",
    "result": "",
    "mode": "search"
  },
  {
    "section": "Search: advanced",
    "topic": "Repeat a captured word",
    "explanation": "In a search pattern, \\1 requires an earlier (...) group and matches its text again.",
    "search": "\\b(\\w+)\\s+\\1\\b",
    "replacement": "",
    "input": "go go",
    "match": "go go",
    "result": "",
    "mode": "search"
  },
  {
    "section": "Replacement: basics",
    "topic": "Replace with fixed text",
    "explanation": "The replacement field supplies the new text.",
    "search": "cat",
    "replacement": "dog",
    "input": "cat",
    "match": "cat",
    "result": "dog",
    "mode": "replace"
  },
  {
    "section": "Replacement: basics",
    "topic": "Delete matching text",
    "explanation": "An empty replacement field deletes the match.",
    "search": "cat",
    "replacement": "",
    "input": "a cat",
    "match": "cat",
    "result": "a ",
    "mode": "replace"
  },
  {
    "section": "Replacement: basics",
    "topic": "Reuse group 1: \\1",
    "explanation": "\\1 reuses the text captured by the first (...) in the search pattern.",
    "search": "(\\d+\\.)",
    "replacement": "## \\1",
    "input": "12. Task",
    "match": "12.",
    "result": "## 12. Task",
    "mode": "replace"
  },
  {
    "section": "Replacement: basics",
    "topic": "Explicit group reference",
    "explanation": "\\g<1> also reuses group 1; it is clear next to digits.",
    "search": "(\\d+\\.)",
    "replacement": "## \\g<1>",
    "input": "12. Task",
    "match": "12.",
    "result": "## 12. Task",
    "mode": "replace"
  },
  {
    "section": "Replacement: basics",
    "topic": "Reuse whole match",
    "explanation": "\\g<0> reuses the entire match, without a capture group.",
    "search": "\\d+",
    "replacement": "[\\g<0>]",
    "input": "A12",
    "match": "12",
    "result": "A[12]",
    "mode": "replace"
  },
  {
    "section": "Replacement: basics",
    "topic": "Insert a newline",
    "explanation": "In regex replacement mode, \\n inserts a newline.",
    "search": "cat",
    "replacement": "cat\\n",
    "input": "catdog",
    "match": "cat",
    "result": "cat\ndog",
    "mode": "replace"
  },
  {
    "section": "Replacement: basics",
    "topic": "Why \\d fails here",
    "explanation": "\\d means digit only in search patterns. In Python replacement text it is an invalid escape; use \\1 or \\g<1>.",
    "search": "(\\d+)",
    "replacement": "## \\d",
    "input": "12",
    "match": "12",
    "result": "Error",
    "mode": "invalid"
  },
  {
    "section": "Replacement: advanced",
    "topic": "Swap two groups",
    "explanation": "Group numbers follow the order of opening parentheses.",
    "search": "(\\w+),(\\w+)",
    "replacement": "\\2 \\1",
    "input": "Sato,Taro",
    "match": "Sato,Taro",
    "result": "Taro Sato",
    "mode": "replace"
  },
  {
    "section": "Replacement: advanced",
    "topic": "Named group",
    "explanation": "(?P<name>...) captures by name; \\g<name> reuses it.",
    "search": "(?P<name>\\w+)",
    "replacement": "[\\g<name>]",
    "input": "Taro",
    "match": "Taro",
    "result": "[Taro]",
    "mode": "replace"
  },
  {
    "section": "Replacement: advanced",
    "topic": "Literal backslash",
    "explanation": "Write \\\\ in regex replacement text to output one backslash.",
    "search": "cat",
    "replacement": "\\\\cat",
    "input": "cat",
    "match": "cat",
    "result": "\\cat",
    "mode": "replace"
  },
  {
    "section": "Replacement: advanced",
    "topic": "Literal text after group",
    "explanation": "\\g<1>0 means group 1 followed by literal 0; \\10 would mean group 10.",
    "search": "(\\d+)",
    "replacement": "\\g<1>0",
    "input": "12",
    "match": "12",
    "result": "120",
    "mode": "replace"
  },
